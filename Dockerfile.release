# =========================================================================
# Aarkam Kdouja — Sovereign LSM & Direct-I/O Storage Engine (v1.0.1)
# Production Container Image (Option A: Release Artifact Distribution)
# =========================================================================
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS runtime

LABEL org.opencontainers.image.title="Aarkam Kdouja" \
      org.opencontainers.image.description="Sovereign Log-Structured Merge Storage Engine & Direct NVMe PageStore Substrate" \
      org.opencontainers.image.version="1.0.1" \
      org.opencontainers.image.vendor="Aarkam.IO" \
      org.opencontainers.image.licenses="Proprietary"

# Install network utilities, TLS certificates, and essential runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    procps \
    iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/kdouja /etc/kdouja /workspace /app \
    && chmod 0755 /var/lib/kdouja /workspace

WORKDIR /workspace

# Copy verified release payload from dist/linux
COPY dist/linux/ /app/

# Ensure execution permissions on native binaries and scripts, and symlink to PATH
RUN chmod +x /app/kdoujad /app/kdouja-cli /app/install-kdouja.sh /app/entrypoint.sh 2>/dev/null || true \
    && ln -sf /app/kdoujad /usr/local/bin/kdoujad \
    && ln -sf /app/kdouja-cli /usr/local/bin/kdouja-cli

# Environment defaults
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    KDOUJA_BASE_DIRECTORY="/var/lib/kdouja" \
    KDOUJA_MEMTABLE_FLUSH_MB="32" \
    KDOUJA_ENABLE_DIRECT_IO="false" \
    KDOUJA_ENABLE_WAL_FSYNC="true"

# Volumes for persistent database storage and configuration
VOLUME ["/var/lib/kdouja", "/etc/kdouja", "/workspace"]

# Default ports: 57771 (gRPC KeyValue & Storage Service), 8080 (Health / HTTP)
EXPOSE 57771 8080

ENTRYPOINT ["/app/entrypoint.sh"]
CMD []
