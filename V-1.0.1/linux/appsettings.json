{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "Kdouja": {
    "BaseDirectory": "kdouja_data",
    "MemTableFlushThresholdBytes": 33554432,
    "MaxL0FilesBeforeCompaction": 4,
    "EnableDirectIO": false,
    "PageSizeBytes": 4096,
    "EnableWalFsync": true
  }
}
