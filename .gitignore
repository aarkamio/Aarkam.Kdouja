# Build & staging outputs
bin/
obj/
dist/
out/
build/
publish/
staging/

# Runtime & local data directories
kdouja_data/
**/kdouja_data/

# Unpacked platform build folders in any version directory
[Vv]-*/linux/
[Vv]-*/win/
[Vv]-*/macos/
[Vv]-*/osx/

# Inside any version folder (V-* / v-*), ignore everything except
# release archives (.zip), installation scripts (.sh, .ps1, .bat, .cmd),
# and documentation / checksums (.md, .txt)
[Vv]-*/*
![Vv]-*/*.zip
![Vv]-*/*.sh
![Vv]-*/*.ps1
![Vv]-*/*.bat
![Vv]-*/*.cmd
![Vv]-*/*.md
![Vv]-*/*.txt

# Temp & OS files
*.tmp
*.log
.DS_Store
Thumbs.db
